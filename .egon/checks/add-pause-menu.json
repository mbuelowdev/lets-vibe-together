[
  {
    "name": "Escape on the desktop pauses it under a full-canvas scrim with Continue, Settings and Save & Quit and muffles the game track; the scrim keeps clicks off the taskbar, Escape or Continue closes it, and the taskbar's Home icon opens it without changing the selected app",
    "scenario": "no_settings",
    "proof": "screenshot",
    "steps": [
      { "await": "window.__egon.state().screen", "equals": "mainMenu" },
      { "click": [320, 185] },
      { "await": "window.__egon.state().screen", "equals": "game" },
      { "expect": "window.__egon.state().paused", "equals": false },
      { "expect": "window.__egon.state().pauseMenuVisible", "equals": false },
      { "expect": "window.__egon.state().musicTrack", "equals": "res://assets/audio/game-music-1.mp3" },
      { "expect": "window.__egon.state().musicMuffled", "equals": false },
      { "press": "Escape" },
      { "await": "window.__egon.state().paused", "equals": true },
      { "expect": "window.__egon.state().pauseMenuVisible", "equals": true },
      { "expect": "window.__egon.state().pauseMenuButtons.join(',')", "equals": "Continue,Settings,Save & Quit" },
      { "expect": "window.__egon.state().pauseMenuScrimRect", "equals": "0,0,640x360" },
      { "expect": "window.__egon.state().musicMuffled", "equals": true },
      { "expect": "window.__egon.state().musicTrack", "equals": "res://assets/audio/game-music-1.mp3" },
      { "screenshot": "pause-menu" },
      { "click": [80, 344] },
      { "expect": "window.__egon.state().selectedApp", "equals": "steam" },
      { "expect": "window.__egon.state().appSwitchCount", "equals": 0 },
      { "expect": "window.__egon.state().paused", "equals": true },
      { "press": "Escape" },
      { "await": "window.__egon.state().paused", "equals": false },
      { "expect": "window.__egon.state().pauseMenuVisible", "equals": false },
      { "expect": "window.__egon.state().musicMuffled", "equals": false },
      { "click": [80, 344] },
      { "await": "window.__egon.state().selectedApp", "equals": "chrome" },
      { "press": "Escape" },
      { "await": "window.__egon.state().paused", "equals": true },
      { "click": [320, 138] },
      { "await": "window.__egon.state().paused", "equals": false },
      { "expect": "window.__egon.state().pauseMenuVisible", "equals": false },
      { "expect": "window.__egon.state().musicMuffled", "equals": false },
      { "click": [16, 344] },
      { "await": "window.__egon.state().paused", "equals": true },
      { "expect": "window.__egon.state().pauseMenuVisible", "equals": true },
      { "expect": "window.__egon.state().selectedApp", "equals": "chrome" },
      { "expect": "window.__egon.state().appSwitchCount", "equals": 1 },
      { "screenshot": "pause-menu-from-home" },
      { "press": "Escape" },
      { "await": "window.__egon.state().paused", "equals": false },
      { "expect": "window.__egon.state().selectedApp", "equals": "chrome" },
      { "expect": "window.__egon.state().backgroundColor", "equals": "#fbbc04" },
      { "expect": "window.__egon.state().focusedControl", "equals": "AppHome" }
    ]
  },
  {
    "name": "The first key press enters the pause column at Continue, the arrows ring its three buttons without reaching the taskbar, and Continue hands focus back to the desktop",
    "scenario": "no_settings",
    "steps": [
      { "await": "window.__egon.state().screen", "equals": "mainMenu" },
      { "click": [320, 185] },
      { "await": "window.__egon.state().screen", "equals": "game" },
      { "click": [112, 344] },
      { "await": "window.__egon.state().selectedApp", "equals": "cs2" },
      { "expect": "window.__egon.state().focusedControl", "equals": "AppCs2" },
      { "press": "Escape" },
      { "await": "window.__egon.state().paused", "equals": true },
      { "expect": "window.__egon.state().focusedControl", "equals": "" },
      { "press": "ArrowDown" },
      { "expect": "window.__egon.state().focusedControl", "equals": "ContinueButton" },
      { "press": "ArrowUp" },
      { "expect": "window.__egon.state().focusedControl", "equals": "SaveQuitButton" },
      { "press": "ArrowDown" },
      { "expect": "window.__egon.state().focusedControl", "equals": "ContinueButton" },
      { "press": "ArrowDown" },
      { "expect": "window.__egon.state().focusedControl", "equals": "SettingsButton" },
      { "press": "ArrowDown" },
      { "expect": "window.__egon.state().focusedControl", "equals": "SaveQuitButton" },
      { "press": "ArrowDown" },
      { "expect": "window.__egon.state().focusedControl", "equals": "ContinueButton" },
      { "press": "ArrowLeft" },
      { "expect": "window.__egon.state().focusedControl", "equals": "ContinueButton" },
      { "press": "Enter" },
      { "await": "window.__egon.state().paused", "equals": false },
      { "expect": "window.__egon.state().pauseMenuVisible", "equals": false },
      { "expect": "window.__egon.state().focusedControl", "equals": "AppCs2" },
      { "expect": "window.__egon.state().selectedApp", "equals": "cs2" }
    ]
  },
  {
    "name": "Settings opens the settings screen over the paused desktop with the game track still muffled; a language picked there reaches the pause menu, and Escape or Back returns to it with the desktop as it was",
    "scenario": "no_settings",
    "proof": "screenshot",
    "steps": [
      { "await": "window.__egon.state().screen", "equals": "mainMenu" },
      { "click": [320, 185] },
      { "await": "window.__egon.state().screen", "equals": "game" },
      { "click": [112, 344] },
      { "await": "window.__egon.state().selectedApp", "equals": "cs2" },
      { "press": "Escape" },
      { "await": "window.__egon.state().paused", "equals": true },
      { "click": [320, 180] },
      { "await": "window.__egon.state().screen", "equals": "settings" },
      { "expect": "window.__egon.state().settingsVisible", "equals": true },
      { "expect": "window.__egon.state().settingsBackground", "equals": "res://assets/images/settings-screen.png" },
      { "expect": "window.__egon.state().pauseMenuVisible", "equals": false },
      { "expect": "window.__egon.state().paused", "equals": true },
      { "expect": "window.__egon.state().musicMuffled", "equals": true },
      { "screenshot": "pause-menu-settings" },
      { "press": "Space" },
      { "expect": "window.__egon.state().focusedControl", "equals": "MasterVolumeSlider" },
      { "press": "ArrowDown" },
      { "press": "ArrowDown" },
      { "press": "ArrowDown" },
      { "expect": "window.__egon.state().focusedControl", "equals": "LanguageSelect" },
      { "press": "Space" },
      { "press": "ArrowDown" },
      { "press": "Enter" },
      { "expect": "window.__egon.state().savedLocale", "equals": "zh_Hans" },
      { "press": "Escape" },
      { "await": "window.__egon.state().screen", "equals": "game" },
      { "expect": "window.__egon.state().pauseMenuVisible", "equals": true },
      { "expect": "window.__egon.state().paused", "equals": true },
      { "expect": "window.__egon.state().focusedControl", "equals": "SettingsButton" },
      { "expect": "window.__egon.state().pauseMenuButtons.join(',')", "equals": "继续,设置,保存并退出" },
      { "expect": "window.__egon.state().settingsVisible === undefined", "equals": true },
      { "expect": "typeof window.__egon.state().rubles", "equals": "number" },
      { "screenshot": "pause-menu-chinese" },
      { "click": [320, 180] },
      { "await": "window.__egon.state().screen", "equals": "settings" },
      { "press": "Space" },
      { "press": "ArrowDown" },
      { "press": "ArrowDown" },
      { "press": "ArrowDown" },
      { "press": "Space" },
      { "press": "ArrowUp" },
      { "press": "Enter" },
      { "expect": "window.__egon.state().savedLocale", "equals": "en" },
      { "click": [72, 327] },
      { "await": "window.__egon.state().screen", "equals": "game" },
      { "expect": "window.__egon.state().pauseMenuButtons.join(',')", "equals": "Continue,Settings,Save & Quit" },
      { "click": [320, 138] },
      { "await": "window.__egon.state().paused", "equals": false },
      { "expect": "window.__egon.state().musicMuffled", "equals": false },
      { "expect": "window.__egon.state().selectedApp", "equals": "cs2" },
      { "expect": "window.__egon.state().screenTexture", "equals": "res://assets/images/screen-base-cs2.png" }
    ]
  }
]
