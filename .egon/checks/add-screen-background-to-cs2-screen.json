[
  {
    "name": "Boot shows no screen artwork and layers the taskbar above the screen node",
    "scenario": "default",
    "proof": "screenshot",
    "steps": [
      { "await": "window.__egon.state().screen", "equals": "mainMenu" },
      { "click": [320, 185] },
      { "await": "window.__egon.state().screen", "equals": "game" },
      { "await": "window.__egon.state().selectedApp", "equals": "steam" },
      { "expect": "window.__egon.state().screenVisible", "equals": false },
      { "expect": "window.__egon.state().screenTexture", "equals": "" },
      { "expect": "window.__egon.state().taskbarAboveScreen", "equals": true },
      { "screenshot": "boot-no-screen-art" }
    ]
  },
  {
    "name": "Selecting cs2 shows the cs2 screen art across the full canvas under the taskbar",
    "scenario": "default",
    "proof": "screenshot",
    "steps": [
      { "await": "window.__egon.state().screen", "equals": "mainMenu" },
      { "click": [320, 185] },
      { "await": "window.__egon.state().screen", "equals": "game" },
      { "await": "window.__egon.state().selectedApp", "equals": "steam" },
      { "click": [112, 344] },
      { "expect": "window.__egon.state().selectedApp", "equals": "cs2" },
      { "expect": "window.__egon.state().screenVisible", "equals": true },
      { "expect": "window.__egon.state().screenTexture", "contains": "screen-base-cs2.png" },
      { "expect": "window.__egon.state().screenTextureSize", "equals": "640x360" },
      { "expect": "window.__egon.state().taskbarVisible", "equals": true },
      { "screenshot": "cs2-screen-art" }
    ]
  },
  {
    "name": "Switching back to Steam hides the screen art and restores the flat colour",
    "scenario": "default",
    "proof": "screenshot",
    "steps": [
      { "await": "window.__egon.state().screen", "equals": "mainMenu" },
      { "click": [320, 185] },
      { "await": "window.__egon.state().screen", "equals": "game" },
      { "click": [112, 344] },
      { "await": "window.__egon.state().screenVisible", "equals": true },
      { "click": [48, 344] },
      { "expect": "window.__egon.state().selectedApp", "equals": "steam" },
      { "expect": "window.__egon.state().screenVisible", "equals": false },
      { "expect": "window.__egon.state().screenTexture", "equals": "" },
      { "expect": "window.__egon.state().backgroundColor", "equals": "#1b2838" },
      { "screenshot": "back-to-steam-flat" }
    ]
  }
]
