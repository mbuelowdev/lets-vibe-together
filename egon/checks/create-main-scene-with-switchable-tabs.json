[
  {
    "name": "Boots into the taskbar shell with home selected",
    "scenario": "default",
    "proof": "screenshot",
    "steps": [
      { "await": "window.__egon.state().appIconCount", "equals": 4 },
      { "expect": "window.__egon.state().taskbarVisible", "equals": true },
      { "expect": "window.__egon.state().selectedApp", "equals": "home" },
      { "expect": "window.__egon.state().backgroundColor", "equals": "#2e4272" },
      { "screenshot": "boot-taskbar-home" }
    ]
  },
  {
    "name": "Clicking the chrome icon selects it and repaints the background",
    "scenario": "default",
    "proof": "screenshot",
    "steps": [
      { "await": "window.__egon.state().selectedApp", "equals": "home" },
      { "click": [240, 492] },
      { "expect": "window.__egon.state().selectedApp", "equals": "chrome" },
      { "expect": "window.__egon.state().backgroundColor", "equals": "#3f6b3a" },
      { "expect": "window.__egon.state().appSwitchCount", "at_least": 1 },
      { "screenshot": "chrome-selected" }
    ]
  },
  {
    "name": "Only one app stays selected across two switches",
    "scenario": "default",
    "proof": "screenshot",
    "steps": [
      { "await": "window.__egon.state().appIconCount", "equals": 4 },
      { "click": [144, 492] },
      { "expect": "window.__egon.state().selectedApp", "equals": "steam" },
      { "click": [336, 492] },
      { "expect": "window.__egon.state().selectedAppIndex", "equals": 3 },
      { "expect": "window.__egon.state().selectedIconCount", "equals": 1 },
      { "expect": "window.__egon.state().backgroundColor", "equals": "#6e3a3a" },
      { "expect": "window.__egon.state().appSwitchCount", "at_least": 2 },
      { "screenshot": "cs2-selected-single" }
    ]
  }
]
